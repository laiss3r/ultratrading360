# ==========================================================================
# UltraTrading360 backend — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
# ==========================================================================

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://ultratrading360.vercel.app

# Set to 1 ONLY for the pytest suite. Never in a real deployment.
DJANGO_ALLOW_INSECURE_TEST_KEY=0

# --- Database (Postgres) --------------------------------------------------
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=ultratrading
POSTGRES_USER=ultratrading
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache + Channels layer) --------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS: the frontend origin allowed to call this API -------------------
CORS_ALLOWED_ORIGINS=https://ultratrading360.vercel.app,http://localhost:3000

# --- Deriv ----------------------------------------------------------------
# App identifier. Used for market data and as the Deriv-App-ID header for PAT calls.
DERIV_APP_ID=90470
DERIV_API_BASE=https://api.derivws.com
DERIV_WS_PUBLIC=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_WS_DEMO=wss://api.derivws.com/trading/v1/options/ws/demo
DERIV_WS_REAL=wss://api.derivws.com/trading/v1/options/ws/real
DERIV_OAUTH_AUTHORIZE_URL=https://auth.deriv.com/oauth2/auth
DERIV_OAUTH_TOKEN_URL=https://auth.deriv.com/oauth2/token

# Fernet key that encrypts Deriv tokens at rest. REQUIRED in production:
# a leaked database must not yield usable trading credentials.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DERIV_TOKEN_FERNET_KEY=

# --- Engine ---------------------------------------------------------------
BOT_LEASE_SECONDS=30
BOT_TICK_SECONDS=1.0
ENGINE_MAX_WORKERS=4
LOG_LEVEL=INFO
