# ==========================================================================
# UltraTrading360 — frontend (Next.js on Vercel) environment template
#
# Copy to `.env.local` for development. On Vercel, set these in
# Project -> Settings -> Environment Variables. NEVER commit the real file.
#
# RULE: nothing secret may use a NEXT_PUBLIC_ prefix. Vercel inlines every
# NEXT_PUBLIC_* value into the client bundle, where anyone can read it.
# ==========================================================================

# --- Secret. Server-side only (API routes). -------------------------------
# Encrypts the httpOnly session cookie that holds the Deriv access token.
# Minimum 16 characters. Generate:  openssl rand -hex 32
# If unset the app still runs, but sessions are ephemeral and the UI says so.
DERIV_SESSION_SECRET=

# Set only if Deriv has issued you an OAuth2 client ID. Without it the OAuth
# login button reports "not configured" and links to the developer portal.
# An app_id is NOT a client_id — they are different credentials.
DERIV_OAUTH_CLIENT_ID=

# --- Non-secret. Server-side with safe defaults. --------------------------
# Must match EXACTLY what you registered with Deriv, including scheme, host
# and trailing slash. Leave unset to derive it from the request origin.
DERIV_REDIRECT_URI=https://ultratrading360.vercel.app/callback

# Deriv application identifier. Used for market data and as the Deriv-App-ID
# header on PAT calls. Public by design — Deriv does not treat it as a secret.
DERIV_APP_ID=90470

# --- Client-visible. Non-secret only. ------------------------------------
# Safe to expose: these are endpoints and identifiers, not credentials.
NEXT_PUBLIC_DERIV_APP_ID=90470
NEXT_PUBLIC_DERIV_WS_PUBLIC=wss://api.derivws.com/trading/v1/options/ws/public
NEXT_PUBLIC_DERIV_API_BASE=https://api.derivws.com
